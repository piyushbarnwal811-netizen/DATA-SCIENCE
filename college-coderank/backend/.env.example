PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/college-coderank
# Optional comma-separated DNS resolver IPs for MongoDB Atlas SRV lookup issues.
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_URL=https://data-science-rho-ten.vercel.app
ADMIN_NAME=College Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeMe123!
GITHUB_TOKEN=
SYNC_CRON=0 0 * * *
INVITATION_EXPIRY_HOURS=24
EMAIL_FROM="CodeRank Administration <admin@rungta.ac.in>"
# Required for real email delivery (configure the same variables in your deployment):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_SECURE=false