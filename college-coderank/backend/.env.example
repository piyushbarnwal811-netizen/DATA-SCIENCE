# Recommended for Render Free Tier (uses HTTPS port 443 - never blocked by cloud firewalls):
# 1. Brevo (Free 300 emails/day, no credit card): https://brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=
# 2. Resend (Free 3000 emails/month): https://resend.com -> API Keys
RESEND_API_KEY=

# Standard SMTP (Works on localhost or paid cloud hosting - note: Render Free Tier blocks outbound SMTP ports 25, 465, 587):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_SECURE=false
