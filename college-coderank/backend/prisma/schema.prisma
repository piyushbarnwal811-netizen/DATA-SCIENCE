generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  password               String
  role                   String    @default("super_admin") // super_admin, admin, tpo, director, hod, teacher
  employeeId             String?   @unique
  phone                  String?
  designation            String?
  qualification          String?
  status                 String    @default("active") // active, inactive, suspended
  directorateId          String?
  directorate            Directorate? @relation("AdminDirectorate", fields: [directorateId], references: [id], onDelete: SetNull)
  departmentId           String?
  department             Department?  @relation("AdminDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  assignedSections       String[]  @default([])
  assignedSubjects       String[]  @default([])
  createdBy              String?
  reportsTo              String?
  mustChangePassword     Boolean   @default(false)
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  resetPasswordUsed      Boolean   @default(false)
  tokenVersion           Int       @default(0)
  maxWeeklyHours         Int       @default(20)
  avatar                 String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  taughtSections       SectionTeacher[]
  timetableAssignments TimetableAssignment[]
  createdInvitations   Invitation[]          @relation("AdminCreatedInvitations")
  auditLogs            AuditLog[]

  @@index([role])
  @@index([status])
  @@index([directorateId])
  @@index([departmentId])
}

model Directorate {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  description     String?
  directorId      String?
  tpoId           String?
  building        String?
  establishedYear Int      @default(2008)
  status          String   @default("active")
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  departments Department[]
  admins      Admin[]      @relation("AdminDirectorate")
  classrooms  Classroom[]
  invitations Invitation[]
  sections    Section[]
}

model Department {
  id            String       @id @default(uuid())
  name          String
  code          String       @unique
  directorateId String?
  directorate   Directorate? @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  hodId         String?
  buildingBlock String?
  floor         String?
  contactEmail  String?
  sections      String[]     @default([])
  status        String       @default("active")
  createdBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sectionRecords       Section[]
  subjects             Subject[]
  admins               Admin[]               @relation("AdminDepartment")
  classrooms           Classroom[]
  invitations          Invitation[]
  timetableAssignments TimetableAssignment[]

  @@index([directorateId])
  @@index([status])
}

model Section {
  id                 String       @id @default(uuid())
  name               String
  departmentId       String
  department         Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  directorateId      String?
  directorate        Directorate? @relation(fields: [directorateId], references: [id], onDelete: SetNull)
  year               Int          @default(1)
  semester           Int          @default(1)
  academicYear       String       @default("2026-2027")
  capacity           Int          @default(60)
  totalStudents      Int          @default(0)
  classTeacherId     String?
  primaryClassroomId String?
  status             String       @default("active")
  createdBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  teachers             SectionTeacher[]
  students             Student[]
  timetableAssignments TimetableAssignment[]

  @@index([departmentId])
  @@index([directorateId])
  @@index([year, semester])
  @@index([status])
}

model SectionTeacher {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Admin    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sectionId, teacherId])
  @@index([sectionId])
  @@index([teacherId])
}

model Subject {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  credits      Int        @default(4)
  semester     Int        @default(5)
  type         String     @default("Theory") // Theory, Practical, Seminar
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  timetableAssignments TimetableAssignment[]

  @@index([departmentId])
}

model Classroom {
  id                 String       @id @default(uuid())
  roomNumber         String       @unique
  name               String?
  building           String
  floor              String       @default("1st Floor")
  type               String       @default("Classroom") // Classroom, Lecture Hall, Computer Lab, Hardware Lab, Seminar Hall, Auditorium
  capacity           Int          @default(60)
  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  directorateId      String?
  directorate        Directorate? @relation(fields: [directorateId], references: [id], onDelete: SetNull)
  hasProjector       Boolean      @default(true)
  hasSmartBoard      Boolean      @default(true)
  hasAirConditioning Boolean      @default(true)
  workstationsCount  Int          @default(0)
  isAvailable        Boolean      @default(true)
  maintenanceStatus  String       @default("Operational") // Operational, Under Maintenance, Reserved
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  timetableAssignments TimetableAssignment[]

  @@index([departmentId])
  @@index([directorateId])
  @@index([isAvailable])
}

model TimetableAssignment {
  id           String      @id @default(uuid())
  teacherId    String
  teacher      Admin       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sectionId    String
  section      Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName  String
  classroomId  String
  classroom    Classroom   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  dayOfWeek    String // Monday, Tuesday, Wednesday, Thursday, Friday, Saturday
  timeSlot     String // e.g. "09:00 - 10:00"
  slotType     String      @default("Lecture") // Lecture, Lab, Tutorial
  academicYear String      @default("2026-2027")
  semester     Int         @default(5)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([classroomId, dayOfWeek, timeSlot, academicYear])
  @@index([teacherId, dayOfWeek, timeSlot, academicYear])
  @@index([sectionId])
  @@index([departmentId])
}

model Student {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  studentId              String?   @unique
  password               String?
  branch                 String
  section                String    @default("A")
  sectionId              String?
  sectionRecord          Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  year                   Int       @default(1)
  leetcodeUsername       String?   @default("")
  githubUsername         String?   @default("")
  hackerrankUsername     String?   @default("")
  codechefUsername       String?   @default("")
  geeksforgeeksUsername  String?   @default("")
  stats                  Json?     @default("{}")
  score                  Float     @default(0)
  isActive               Boolean   @default(true)
  mustChangePassword     Boolean   @default(false)
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  resetPasswordUsed      Boolean   @default(false)
  tokenVersion           Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([branch])
  @@index([section])
  @@index([year])
  @@index([score])
  @@index([isActive])
}

model Invitation {
  id             String       @id @default(uuid())
  name           String
  email          String
  role           String // tpo, director, hod, teacher
  directorateId  String?
  directorate    Directorate? @relation(fields: [directorateId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  status         String       @default("pending") // pending, accepted, expired, revoked
  expiresAt      DateTime
  invitedBy      String?
  invitedByAdmin Admin?       @relation("AdminCreatedInvitations", fields: [invitedBy], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  revokedAt      DateTime?
  revokedBy      String?
  lastSentAt     DateTime?
  resendCount    Int          @default(0)
  createdUserId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       Admin?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String   @default("")
  userEmail  String   @default("")
  role       String   @default("")
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  details    String   @default("")
  ipAddress  String?  @default("127.0.0.1")
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([createdAt])
}
